<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:fillViewport="true"
    tools:openDrawer="end">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background_main">

        <!-- 固定在顶部的操作栏 -->
        <LinearLayout
            android:id="@+id/top_action_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/menubutton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/open_settings"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/twotone_menu_24"
                app:tint="@color/text_main" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/deletebutton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/twotone_delete_24"
                app:tint="@color/primary_brand" />

            <ImageView
                android:id="@+id/editbutton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/twotone_edit_24"
                app:tint="@color/primary_brand" />

            <ImageView
                android:id="@+id/addbutton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/twotone_add_24"
                app:tint="@color/primary_brand" />
        </LinearLayout>

        <!-- 滚动区域 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/background_main"
            android:fitsSystemWindows="true"
            android:fillViewport="true"
            android:scrollbars="none">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/main"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="500dp"
                android:layout_gravity="center_horizontal"
                android:paddingBottom="20dp"
                tools:context=".MainActivity">

                <!-- 1. 打印机选择 -->
                <Spinner
                    android:id="@+id/type"
                    android:layout_width="280dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="24dp"
                    android:spinnerMode="dialog"
                    app:backgroundTint="@color/text_main"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/typeborder"
                    android:layout_width="280dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/border"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/lbltype"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/hint_background"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:includeFontPadding="false"
                    android:text="@string/printer"
                    android:textColor="@color/primary_brand"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toTopOf="@+id/typeborder"
                    app:layout_constraintStart_toStartOf="@+id/typeborder"
                    app:layout_constraintTop_toTopOf="@+id/typeborder" />

                <!-- 2. 品牌选择 -->
                <Spinner
                    android:id="@+id/brand"
                    android:layout_width="280dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:spinnerMode="dialog"
                    app:backgroundTint="@color/text_main"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/type" />

                <View
                    android:id="@+id/brandborder"
                    android:layout_width="280dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/border"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/type" />

                <TextView
                    android:id="@+id/lblbrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/hint_background"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:includeFontPadding="false"
                    android:text="@string/brand"
                    android:textColor="@color/primary_brand"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toTopOf="@+id/brandborder"
                    app:layout_constraintStart_toStartOf="@+id/brandborder"
                    app:layout_constraintTop_toTopOf="@+id/brandborder" />

                <!-- 3. 类型选择 -->
                <Spinner
                    android:id="@+id/mtype"
                    android:layout_width="280dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:spinnerMode="dialog"
                    app:backgroundTint="@color/text_main"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/brand" />

                <View
                    android:id="@+id/mtypeborder"
                    android:layout_width="280dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/border"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/brand" />

                <TextView
                    android:id="@+id/lblmtype"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/hint_background"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:includeFontPadding="false"
                    android:text="@string/type"
                    android:textColor="@color/primary_brand"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toTopOf="@+id/mtypeborder"
                    app:layout_constraintStart_toStartOf="@+id/mtypeborder"
                    app:layout_constraintTop_toTopOf="@+id/mtypeborder" />

                <!-- 4. 名称选择 -->
                <Spinner
                    android:id="@+id/material"
                    android:layout_width="280dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:spinnerMode="dialog"
                    app:backgroundTint="@color/text_main"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/mtype" />

                <View
                    android:id="@+id/materialborder"
                    android:layout_width="280dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/border"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/mtype" />

                <TextView
                    android:id="@+id/lblmaterial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/hint_background"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:includeFontPadding="false"
                    android:text="@string/name"
                    android:textColor="@color/primary_brand"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toTopOf="@+id/materialborder"
                    app:layout_constraintStart_toStartOf="@+id/materialborder"
                    app:layout_constraintTop_toTopOf="@+id/materialborder" />

                <!-- 5. 重量选择 -->
                <Spinner
                    android:id="@+id/spoolsize"
                    android:layout_width="280dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:spinnerMode="dialog"
                    app:backgroundTint="@color/text_main"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/material" />

                <View
                    android:id="@+id/sizeborder"
                    android:layout_width="280dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/border"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/material" />

                <ImageView
                    android:id="@+id/sizearrow"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_arrow_down"
                    app:tint="@color/text_main"
                    app:layout_constraintBottom_toBottomOf="@+id/sizeborder"
                    app:layout_constraintEnd_toEndOf="@+id/sizeborder"
                    app:layout_constraintTop_toTopOf="@+id/sizeborder" />

                <TextView
                    android:id="@+id/lblsize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/hint_background"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:includeFontPadding="false"
                    android:text="@string/weight"
                    android:textColor="@color/primary_brand"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toTopOf="@+id/sizeborder"
                    app:layout_constraintStart_toStartOf="@+id/sizeborder"
                    app:layout_constraintTop_toTopOf="@+id/sizeborder" />

                <!-- 6. 颜色选择 -->
                <Spinner
                    android:id="@+id/colorspin"
                    android:layout_width="280dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:spinnerMode="dialog"
                    app:backgroundTint="@color/text_main"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/spoolsize" />

                <View
                    android:id="@+id/colorborder"
                    android:layout_width="280dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/border"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/spoolsize" />

                <View
                    android:id="@+id/colorview"
                    android:layout_width="225dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="40dp"
                    android:background="#0000FF"
                    app:layout_constraintEnd_toEndOf="@+id/colorborder"
                    app:layout_constraintStart_toStartOf="@+id/colorborder"
                    app:layout_constraintTop_toTopOf="@+id/colorborder" />

                <TextView
                    android:id="@+id/txtcolor"
                    android:layout_width="225dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="40dp"
                    android:background="#00000000"
                    android:textSize="18sp"
                    android:paddingStart="10dp"
                    android:singleLine="true"
                    android:paddingEnd="1dp"
                    android:gravity="start|center"
                    android:text="@string/default_hex_color"
                    app:layout_constraintEnd_toEndOf="@+id/colorborder"
                    app:layout_constraintStart_toStartOf="@+id/colorborder"
                    app:layout_constraintTop_toTopOf="@+id/colorborder" />

                <TextView
                    android:id="@+id/lblcolor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/hint_background"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:includeFontPadding="false"
                    android:text="@string/color"
                    android:textColor="@color/primary_brand"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toTopOf="@+id/colorborder"
                    app:layout_constraintStart_toStartOf="@+id/colorborder"
                    app:layout_constraintTop_toTopOf="@+id/colorborder" />

                <!-- 7. 标签ID行 -->
                <TextView
                    android:id="@+id/lbltagid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="32dp"
                    android:text="@string/tag_id"
                    android:textColor="@color/text_main"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/colorborder" />

                <TextView
                    android:id="@+id/tagid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginEnd="40dp"
                    android:text="@string/_00_00_00_00"
                    android:textColor="@color/text_main"
                    android:textSize="18sp"
                    android:singleLine="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/lbltagid"
                    app:layout_constraintTop_toBottomOf="@+id/colorborder" />

                <ImageView
                    android:id="@+id/smbutton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    android:visibility="invisible"
                    android:drawablePadding="8dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"
                    app:srcCompat="@drawable/spoolman"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/lbltagid"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/txtmsg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="invisible"
                    android:gravity="center"
                    android:textColor="#FA6F6F"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/lbltagid" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

        <!-- 固定在底部的操作栏 -->
        <LinearLayout
            android:id="@+id/button_container"
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:background="@color/background_main">

            <Button
                android:id="@+id/readbutton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="40dp"
                android:padding="14dp"
                android:text="@string/read"
                android:textColor="@color/text_inverted"
                android:textSize="16sp"
                tools:ignore="ButtonStyle" />

            <Button
                android:id="@+id/writebutton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:padding="14dp"
                android:text="@string/write"
                android:textColor="@color/text_inverted"
                android:textSize="16sp"
                tools:ignore="ButtonStyle" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="false"
        android:theme="@style/Theme.MaterialComponents.DayNight"
        app:itemTextAppearance="@style/NavigationDrawerText"
        app:headerLayout="@layout/nav_header_main"
        app:menu="@menu/activity_main_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>